{
  "name": "@basicrum/beacon-client",
  "author": {
    "name": "Basicrum"
  },
  "version": "0.1.1",
  "description": "Client-side Real User Monitoring beacon for Basicrum",
  "homepage": "https://github.com/basicrum/beacon-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basicrum/beacon-client.git"
  },
  "bugs": {
    "url": "https://github.com/basicrum/beacon-client/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.mts"
    }
  },
  "files": [
    "dist",
    "asset",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "generate": "node scripts/generate-boomerang-source.mjs",
    "build": "pnpm generate && tsdown",
    "test": "vitest run",
    "check": "biome check",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^27.4.0",
    "tsdown": "^0.21.9",
    "typescript": "^5.6.2",
    "vitest": "^4.1.4"
  },
  "boomerang": {
    "version": "1.815.60",
    "commit": "564759ed70de7801bb64de5e2025fb6ac049ff5f",
    "repo": "https://github.com/basicrum/boomerang",
    "flavor": "cutting-edge"
  },
  "keywords": [
    "rum",
    "real-user-monitoring",
    "performance",
    "boomerang",
    "beacon",
    "web-vitals"
  ],
  "license": "MIT"
}
